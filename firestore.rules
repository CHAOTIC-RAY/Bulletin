rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Firebase Web API keys are public identifiers, not authorization.
    // Public clients may read already-cached public speech, but only a trusted
    // server identity should create, update, sweep, or delete shared cache docs.
    // Until server-side authenticated writes are configured, fail closed.
    match /pollyCache/{hash} {
      allow get, list: if hash.matches('^[a-fA-F0-9]{40}$');
      allow create, update, delete: if false;
    }

    match /pollyCacheMeta/{docId} {
      allow get: if docId == 'sweep';
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
