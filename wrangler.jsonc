{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "raadhavalhi",
  "main": "src/worker.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
